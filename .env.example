# Copy this file to .env and fill in your own values.
# Never commit the real .env file — it is gitignored.

PORT=5000

# MongoDB credentials (cluster0.4dwew1j.mongodb.net)
MONGODB_USERNAME_URL=
MONGODB_PASSWORD_URL=

# JWT signing secret (long random string)
JWT_SECRET=

# Stripe secret key (test or live)
STRIPE_SECRET_KEY=

# Deployed client URL used for Stripe success/cancel redirects (no trailing slash)
# Local: http://localhost:3000 | Production: https://your-client-domain.vercel.app
CLIENT_BASE_URL=http://localhost:3000
